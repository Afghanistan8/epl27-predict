# Copy to .env and fill in. .env is gitignored — never commit real keys.

# GenLayer deploy/resolve/predict wallet (must be the AIPredictor admin).
PRIVATE_KEY=

# Deployed AIPredictor contract (from deploy-ai.js / ai_predictor_address.txt).
AI_PREDICTOR_ADDRESS=

# EPL Supabase project (ref lhcazntvrolghupdsheh).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # sb_secret_… — backend/cron only, never in the browser

# football-data.org free API key (fixtures, live scores, standings).
FOOTBALL_DATA_API_KEY=

# Real-time score broadcast (optional).
ABLY_API_KEY=

# Bearer token cron-job.org sends to the Vercel cron endpoints.
CRON_SECRET=
